---
import { markdown, pfad, zeile } from '../../lib/hilfen';
const { titel, text, eintraege } = Astro.props;
---
<div class="container">
  {(titel || text) && (
    <div class="abschnittskopf">
      {titel && <h2 set:html={zeile(titel)} />}
      {text && <div set:html={markdown(text)} />}
    </div>
  )}
  <ul class="logos">
    {eintraege.map((e: any) => (
      <li><img src={pfad(e.bild)} alt={e.name} title={e.name} loading="lazy" decoding="async" /></li>
    ))}
  </ul>
</div>

<style>
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: 14px;
  }
  li {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: 18px;
    background: #fff;
    border: 1px solid var(--linie);
    border-radius: 12px;
  }
  img { max-height: 64px; width: auto; object-fit: contain; filter: grayscale(1); opacity: 0.75; transition: filter 0.2s, opacity 0.2s; }
  li:hover img { filter: none; opacity: 1; }
</style>
