---
import { link, markdown, zeile } from '../../lib/hilfen';
const { titel, einleitung, spalten, bildformat, eintraege } = Astro.props;
---
<div class="container">
  {(titel || einleitung) && (
    <div class="abschnittskopf">
      {titel && <h2 set:html={zeile(titel)} />}
      {einleitung && <p set:html={zeile(einleitung)} />}
    </div>
  )}
  <div class={`karten s${spalten} b-${bildformat}`}>
    {eintraege.map((e: any) => {
      const Tag = e.link ? 'a' : 'article';
      return (
        <Tag class:list={['karte', { verlinkt: e.link }]} href={e.link ? link(e.link) : undefined}>
          {e.bild && (
            <div class="bild">
              <img src={e.bild} alt={e.alt ?? ''} loading="lazy" decoding="async" />
            </div>
          )}
          <div class="inhalt">
            <h3 set:html={zeile(e.titel)} />
            {e.text && <div class="text" set:html={markdown(e.text)} />}
            {e.link && <span class="mehr">{e.linktext ?? 'Mehr erfahren'} <span aria-hidden="true">→</span></span>}
          </div>
        </Tag>
      );
    })}
  </div>
</div>

<style>
  .karten { display: grid; gap: clamp(16px, 2.5vw, 28px); }
  .s2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .s3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .s4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .karte {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--linie);
    border-radius: var(--radius);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .verlinkt:hover { transform: translateY(-4px); box-shadow: var(--schatten); border-color: color-mix(in oklab, var(--akzent) 35%, var(--linie)); color: inherit; }
  .bild { background: #fff; border-bottom: 1px solid var(--linie); }
  .bild img { width: 100%; object-fit: contain; padding: 12px; }
  .b-breit .bild img { aspect-ratio: 3 / 2; }
  .b-quadrat .bild img { aspect-ratio: 1; }
  .b-frei .bild img { padding: 0; object-fit: cover; aspect-ratio: 4 / 3; }
  .inhalt { display: flex; flex-direction: column; flex: 1; padding: 22px 24px 24px; }
  h3 { margin-bottom: 0.4em; }
  .text { color: var(--text-leise); font-size: 0.98rem; }
  .text :global(p:last-child) { margin-bottom: 0; }
  .mehr { margin-top: auto; padding-top: 14px; color: var(--akzent); font-weight: 600; }
  .verlinkt:hover .mehr span { display: inline-block; transform: translateX(3px); transition: transform 0.2s; }
  @media (max-width: 1000px) { .s4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .s3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 580px) { .s2, .s3, .s4 { grid-template-columns: minmax(0, 1fr); } }
</style>
