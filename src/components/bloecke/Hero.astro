---
import { link, zeile } from '../../lib/hilfen';
const { oberzeile, titel, text, bild, alt, knopf, link: ziel, knopf2, link2 } = Astro.props;
---
<div class="hero">
  <div class="container raster">
    <div class="text">
      {oberzeile && <span class="oberzeile" set:html={zeile(oberzeile)} />}
      <h1 set:html={zeile(titel)} />
      {text && <p class="lead" set:html={zeile(text)} />}
      <div class="knoepfe">
        {knopf && ziel && <a class="knopf" href={link(ziel)}>{knopf} <span aria-hidden="true">→</span></a>}
        {knopf2 && link2 && <a class="knopf zweit" href={link(link2)}>{knopf2}</a>}
      </div>
    </div>
    {bild && (
      <div class="bild">
        <img src={bild} alt={alt ?? ''} fetchpriority="high" decoding="async" />
      </div>
    )}
  </div>
</div>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(900px 500px at 80% 40%, color-mix(in oklab, var(--akzent) 14%, transparent), transparent 70%),
      linear-gradient(180deg, var(--flaeche-2) 0%, #fff 100%);
  }
  .hero::before {
    content: '';
    position: absolute;
    right: -160px;
    top: 50%;
    width: 620px;
    height: 620px;
    transform: translateY(-50%);
    border-radius: 50%;
    border: 46px dashed color-mix(in oklab, var(--akzent) 10%, transparent);
    pointer-events: none;
  }
  .raster {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(32px, 6vw, 72px);
  }
  h1 { max-width: 16ch; }
  .lead { margin-bottom: 2rem; }
  .knoepfe { display: flex; flex-wrap: wrap; gap: 12px; }
  .knopf.zweit { color: var(--akzent); }
  .knopf.zweit:hover { background: var(--akzent-hell); }
  .bild img { width: 100%; max-height: min(60vh, 560px); object-fit: contain; mix-blend-mode: multiply; filter: drop-shadow(0 30px 40px rgb(11 26 43 / 18%)); }
  @media (max-width: 820px) {
    .raster { grid-template-columns: minmax(0, 1fr); }
    .bild { order: -1; max-width: 520px; }
  }
</style>
